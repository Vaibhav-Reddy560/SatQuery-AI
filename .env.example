# SatQuery AI Environment Configuration

# Frontend (Vite) — set these in Vercel's project env settings for the
# deployed build, since the app has no server to fall back to at runtime.
VITE_API_BASE_URL="http://localhost:8000/api/v1"
# VITE_MAP_STYLE_URL="https://api.maptiler.com/maps/your-style/style.json?key=YOUR_KEY"

# Backend

PROJECT_NAME="SatQuery AI Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="satquery_secret_key_sih2026_isro_space_tech_987654321"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite for local dev, PostgreSQL for docker/prod)
DATABASE_URL="sqlite:///./satquery.db"
# DATABASE_URL="postgresql://satquery:satquery123@localhost:5432/satquery_db"

# Redis & Task Queue
REDIS_URL="redis://localhost:6379/0"

# Model Serving & Multimodal Remote Sensing Config
MODEL_NAME="SatQuery-VLM-Sentinel-v1"
MODEL_DEVICE="cuda"  # "cuda" or "cpu"
ENABLE_REAL_MODEL=False

# Remote Sensing Datasets
BIGEARTHNET_DIR="./data/bigearthnet"
VRSBENCH_DIR="./data/vrsbench"

# Phase 2 NDVI imagery provider
#   "sample"    = bundled real Sentinel-2 cutout (offline, deterministic, default)
#   "sentinel2" = live Sentinel-2 COG fetch via public Earth Search STAC (free, no key)
IMAGERY_PROVIDER="sample"
SENTINEL2_LOOKBACK_DAYS=120
SENTINEL2_MAX_CLOUD_PERCENT=60
